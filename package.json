    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.75.0",
    "@mkody/vue3-simple-icons": "^16.37.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "ai": "^7.0.176",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.18",
    "node-diff3": "^4.0.0",
    "ofetch": "^1.5.1",
    "pinia": "^4.1.0",
    "quill": "^2.0.3",
    "vue": "^3.5.45",
    "vue-advanced-cropper": "^2.8.9",
    "vue-draggable-plus": "^0.6.1",
    "wikiparser-node": "^2.1.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openvue/themes": "1.1.1",
    "@pinia/testing": "^2.0.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "lightningcss": "1.33.0",
    "openvue": "1.1.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
