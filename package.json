{
  "name": "pcgw-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "defaults"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b --force",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings=0",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.69",
    "@ai-sdk/google": "^4.0.86",
    "@ai-sdk/openai": "^4.0.82",
